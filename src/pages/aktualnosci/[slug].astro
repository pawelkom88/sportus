---
import { documentToHtmlString } from "@contentful/rich-text-html-renderer";
import { Picture } from "astro:assets";
import type { Entry, EntrySkeletonType } from "contentful";
import Layout from "../../layouts/Layout.astro";
import { contentfulClient } from "../../lib/contentful";

export async function getStaticPaths() {
  try {
    const data = await contentfulClient.getEntries({
      content_type: "cardArticle",
    });

    return data.items.map((article: Entry<EntrySkeletonType>) => {
      return {
        params: { slug: article.fields.slug },
        props: {
          heading: article.fields.heading,
          content: documentToHtmlString(article.fields.text as any),
          date: new Date(article.fields.date as any).toLocaleDateString("pl-PL", {
            year: "numeric",
            month: "long",
            day: "numeric",
          }),
          rawDate: article.fields.date
            ? new Date(article.fields.date as any).toISOString().split("T")[0]
            : "",
          image: {
            width: (article.fields.image as any)?.fields?.file?.details?.image?.width || 800,
            height: (article.fields.image as any)?.fields?.file?.details?.image?.height || 600,
            url: ((article.fields.image as any)?.fields?.file?.url || "").replace(/^https?:?\/\//, ""),
          },
          imageAlt: (article.fields.imageAlt as string) || (article.fields.heading as string),
          SEOtitle: article.fields.seOtitle as string,
          SEOdescription: article.fields.seOdescription as string,
        },
      };
    });
  } catch (error) {
    console.warn("[Contentful] Could not fetch articles for getStaticPaths:", error);
    return [];
  }
}

const { heading, content, date, rawDate, image, SEOtitle, SEOdescription, imageAlt } =
  Astro.props;

const pageTitle = SEOtitle || `${heading} | Sportuś Gdańsk`;
const pageDescription =
  SEOdescription ||
  `Przeczytaj artykuł: ${heading}. Aktualności z życia Akademii Sportuś w Gdańsku.`;
const postImage = {
  src: image?.url ? `https://${image.url}` : "https://sportus.com.pl/social-media-card.webp",
  alt: String(imageAlt || heading || "Sportuś Gdańsk"),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={postImage}
  jsonLDType="post"
  post={{
    title: heading,
    description: pageDescription,
    image: postImage,
    date: rawDate,
    author: "Krzysztof Iwanowski",
  }}
>
  <section class="article-container">
    <article>
      <header>
        <h1 class="cs-title">{heading}</h1>
      </header>
      <Picture
        class="article-image"
        width={image.width}
        height={image.height}
        fallbackFormat="jpg"
        formats={["avif", "webp"]}
        src={`https://${image.url}`}
        alt={imageAlt}
      />
      <div class="content-wrapper">
        <slot set:html={content} />
      </div>
      <time class="article-date" datetime={rawDate || date}>Opublikowano: {date}</time>
    </article>
  </section>
</Layout>

<style>
  .article-container {
    padding-top: clamp(10rem, 20vw, 12.5rem);
    padding-inline: 1rem;
    width: 100%;
    max-width: 90ch;
    margin: 0 auto 2rem;
  }

  .article-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 1rem;
  }

  .content-wrapper {
    margin: 2rem 0;
  }

  .content-wrapper :global(ul) {
    list-style-type: circle;
  }

  .content-wrapper :global(p) {
    font-size: var(--bodyFontSize);
    line-height: 1.5em;
    text-align: justify;
    width: 100%;
    margin: 0;
    text-justify: inter-word;
    text-wrap: pretty;
  }

  .content-wrapper :global(h2) {
  }

  .article-date {
    margin-top: 2rem;
    font-style: italic;
  }
</style>
