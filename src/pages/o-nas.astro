---
import { Picture } from "astro:assets";
import image from "../assets/images/Krzysztof-Iwanowski.jpg";
import imageTrain1 from "../assets/images/zajecia-sportowe-dzieci-trener-pilka-siadanie.webp";
import imageTrain2 from "../assets/images/trener-pieczatki-nagradzanie-dzieci-krag.webp";
import imageTrain3 from "../assets/images/odprawa-dzieci-z-trenerem-kregielka.webp";
import imageTrain4 from "../assets/images/cwiczenia-koordynacyjne-tor-przeszkod-bramka.webp";
import Layout from "../layouts/Layout.astro";
import "../styles/trener.css";

const calculateAge = (birthDate: Date) => {
  const today = new Date();
  let age = today.getFullYear() - birthDate.getFullYear();
  const m = today.getMonth() - birthDate.getMonth();
  if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
    age--;
  }
  return age;
};

const majaAge = calculateAge(new Date("2019-05-01"));
const marikaAge = calculateAge(new Date("2024-04-01"));
---

<Layout
  title="O nas - Trener Krzysztof Iwanowski | Sportuś Gdańsk"
  description="Poznaj Krzysztofa Iwanowskiego – licencjonowanego trenera i założyciela Sportusia. Sprawdź nasze doświadczenie w zajęciach sportowych dla dzieci w Gdańsku."
>
  <section id="sbs-1125">
    <div class="cs-container">
      <div>
        <!-- Left Image Section -->
        <div class="cs-image-group">
          <!--Main Image-->
          <Picture
            fallbackFormat="jpg"
            class="cs-picture"
            width="1500"
            height="1000"
            src={image}
            formats={["avif", "webp"]}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            alt="Krzysztof Iwanowski podczas meczu piłkarskiego w barwach Lechii Gdańsk"
          />
        </div>

        <div class="cs-bottom-group">
          <button
            type="button"
            aria-label="Powiększ zdjęcie: Trener wręcza piłkę dzieciom siedzącym w rzędzie podczas zajęć sportowych"
            title="Kliknij, aby powiększyć zdjęcie"
            class="cs-image-btn"
          >
            <Picture
              fallbackFormat="jpg"
              class="cs-bottom-small"
              formats={["avif", "webp"]}
              src={imageTrain1}
              width="600"
              height="450"
              loading="lazy"
              decoding="async"
              alt="Trener wręcza piłkę dzieciom siedzącym w rzędzie podczas zajęć sportowych Sportuś"
            />
          </button>
          <button
            type="button"
            aria-label="Powiększ zdjęcie: Trener przybija nagradzające pieczątki dzieciom siedzącym w kole"
            title="Kliknij, aby powiększyć zdjęcie"
            class="cs-image-btn"
          >
            <Picture
              fallbackFormat="jpg"
              class="cs-bottom-small"
              formats={["avif", "webp"]}
              src={imageTrain2}
              width="600"
              height="450"
              loading="lazy"
              decoding="async"
              alt="Trener przybija nagradzające pieczątki dzieciom zebranym w kręgu po treningu Sportuś"
            />
          </button>
          <button
            type="button"
            aria-label="Powiększ zdjęcie: Odprawa i wspólne omówienie ćwiczeń trenera z dziećmi"
            title="Kliknij, aby powiększyć zdjęcie"
            class="cs-image-btn"
          >
            <Picture
              fallbackFormat="jpg"
              class="cs-bottom-small"
              formats={["avif", "webp"]}
              src={imageTrain3}
              width="600"
              height="450"
              loading="lazy"
              decoding="async"
              alt="Trener rozmawia i tłumaczy zasady zabawy dzieciom siedzącym na dywanie w sali"
            />
          </button>
          <button
            type="button"
            aria-label="Powiększ zdjęcie: Ćwiczenia koordynacyjne i tor przeszkód z mini bramką dla dzieci"
            title="Kliknij, aby powiększyć zdjęcie"
            class="cs-image-btn"
          >
            <Picture
              fallbackFormat="jpg"
              class="cs-bottom-small"
              formats={["avif", "webp"]}
              src={imageTrain4}
              width="600"
              height="450"
              loading="lazy"
              decoding="async"
              alt="Dzieci pokonują kolorowy tor przeszkód z mini bramką na zajęciach ogólnorozwojowych"
            />
          </button>
        </div>
      </div>
      <!-- Right Content Section-->
      <div class="cs-content">
        <span class="cs-topper">PASJA I DOŚWIADCZENIE</span>
        <h1 class="cs-title">Od piłkarskich boisk Lechii Gdańsk do pracy z dziećmi</h1>
        <p class="cs-text">
          Misją Sportusia jest wprowadzenie dzieci w świat sportu i aktywności fizycznej
          poprzez zabawę, kształtowanie zdrowych nawyków oraz rozwój charakteru. Zajęcia
          są skierowane do dzieci w wieku od 4 do 10 lat, a ich głównym celem jest
          pokazanie, że sport może być dostępny i przyjemny dla każdego, niezależnie od
          predyspozycji czy ograniczeń.
        </p>
        <p class="cs-text">
          W Sportusiu dbamy o wszechstronny rozwój dzieci, wplatając elementy różnych
          dyscyplin sportowych w kreatywne gry i zabawy ruchowe. Dzięki temu nasi mali
          podopieczni mogą nie tylko poprawiać kondycję fizyczną, ale także rozwijać cechy
          takie jak wytrwałość, współpraca i samodyscyplina. Wierzymy, że regularna
          aktywność fizyczna wspiera zdrowy rozwój dzieci, dlatego nasi trenerzy, z pasją
          i doświadczeniem, angażują dzieci do aktywności i pokazują, że sport to przede
          wszystkim zabawa i radość z ruchu.
        </p>
        <p class="cs-text">
          Sportuś to projekt stworzony przez Krzysztofa Iwanowskiego, absolwenta Akademii
          Wychowania Fizycznego i Sportu w Gdańsku, licencjonowanego trenera piłki nożnej
          oraz zawodowego piłkarza, który swoje sportowe doświadczenie zdobywał, grając
          m.in. w takich klubach jak Lechia Gdańsk, Olimpia Elbląg czy Bałtyk Gdynia. Jako
          tata {majaAge}-letniej Mai i {marikaAge}-letniej Mariki doskonale rozumie, jak ważne jest
          zaszczepienie dzieciom pasji do ruchu już od najmłodszych lat oraz jak głęboko
          aktywność fizyczna wpływa na ich rozwój i dobre samopoczucie.
        </p>
      </div>
    </div>

    <dialog aria-label="Galeria zdjęć" class="cs-dialog">
      <div class="cs-dialog-shell">
        <header class="cs-dialog-header">
          <span class="cs-dialog-counter" aria-live="polite">Zdjęcie 1 z 4</span>
          <button type="button" class="cs-dialog-close" aria-label="Zamknij podgląd zdjęcia">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </header>

        <div class="cs-dialog-stage">
          <figure class="cs-dialog-figure">
            <img class="cs-dialog-img" src="" alt="" />
            <figcaption class="cs-dialog-caption"></figcaption>
          </figure>
        </div>

        <footer class="cs-dialog-footer">
          <button type="button" class="cs-nav-btn cs-nav-prev" aria-label="Poprzednie zdjęcie">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            <span class="cs-nav-btn-text">Poprzednie</span>
          </button>

          <button type="button" class="cs-nav-btn cs-nav-next" aria-label="Następne zdjęcie">
            <span class="cs-nav-btn-text">Następne</span>
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </footer>
      </div>
    </dialog>
  </section>
  <!-- <History /> -->
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const imagesContainer = document.querySelector(".cs-bottom-group");
    const modalDialog = document.querySelector<HTMLDialogElement>(".cs-dialog");
    if (!imagesContainer || !modalDialog) return;

    const thumbnails = Array.from(
      imagesContainer.querySelectorAll<HTMLImageElement>(".cs-bottom-small")
    );
    const dialogImg = modalDialog.querySelector<HTMLImageElement>(".cs-dialog-img");
    const dialogCaption = modalDialog.querySelector<HTMLElement>(".cs-dialog-caption");
    const dialogCounter = modalDialog.querySelector<HTMLElement>(".cs-dialog-counter");
    const closeButton = modalDialog.querySelector<HTMLButtonElement>(".cs-dialog-close");
    const prevButton = modalDialog.querySelector<HTMLButtonElement>(".cs-nav-prev");
    const nextButton = modalDialog.querySelector<HTMLButtonElement>(".cs-nav-next");

    let currentIndex = 0;

    function renderImage(index: number) {
      if (index < 0 || index >= thumbnails.length) return;
      currentIndex = index;
      const targetImg = thumbnails[currentIndex];

      if (dialogImg) {
        dialogImg.src = targetImg.currentSrc || targetImg.src;
        dialogImg.alt = targetImg.alt || "";
      }
      if (dialogCaption) {
        dialogCaption.textContent = targetImg.alt || "";
      }
      if (dialogCounter) {
        dialogCounter.textContent = `Zdjęcie ${currentIndex + 1} z ${thumbnails.length}`;
      }

      if (prevButton) {
        prevButton.disabled = currentIndex <= 0;
        prevButton.setAttribute("aria-disabled", String(currentIndex <= 0));
      }
      if (nextButton) {
        nextButton.disabled = currentIndex >= thumbnails.length - 1;
        nextButton.setAttribute("aria-disabled", String(currentIndex >= thumbnails.length - 1));
      }
    }

    function openModal(index: number) {
      renderImage(index);
      modalDialog?.showModal();
      closeButton?.focus();
    }

    function closeModal() {
      modalDialog?.close();
    }

    // Click handler for thumbnails
    imagesContainer.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest(".cs-image-btn");
      if (!button) return;
      const img = button.querySelector<HTMLImageElement>(".cs-bottom-small");
      if (!img) return;
      const index = thumbnails.indexOf(img);
      if (index !== -1) {
        openModal(index);
      }
    });

    closeButton?.addEventListener("click", closeModal);

    prevButton?.addEventListener("click", () => {
      if (currentIndex > 0) renderImage(currentIndex - 1);
    });

    nextButton?.addEventListener("click", () => {
      if (currentIndex < thumbnails.length - 1) renderImage(currentIndex + 1);
    });

    // Keyboard navigation when dialog is open
    modalDialog.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowRight") {
        e.preventDefault();
        if (currentIndex < thumbnails.length - 1) renderImage(currentIndex + 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        if (currentIndex > 0) renderImage(currentIndex - 1);
      }
    });

    // Close when clicking outside content (on backdrop)
    modalDialog.addEventListener("click", (e: MouseEvent) => {
      if (e.target === modalDialog) {
        closeModal();
      }
    });
  });
</script>
